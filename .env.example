ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
DATABASE_PATH=backend/wallet_scores.db
# Optional production replacement:
# DATABASE_URL=postgresql+psycopg://dwts:change-me@localhost:5432/dwts
POSTGRES_DB=dwts
POSTGRES_USER=dwts
POSTGRES_PASSWORD=
MODEL_PATH=backend/app/ml/model.pkl
DATASET_PATH=data/transaction_dataset.csv
VITE_API_URL=http://localhost:8000
WEB3_PROVIDER_URL=
# Comma-separated primary/fallback providers; overrides WEB3_PROVIDER_URL.
WEB3_PROVIDER_URLS=
# WebSocket endpoint for provider-visible pending transactions.
# Optional for Alchemy; derived from WEB3_PROVIDER_URL when blank.
WEB3_WS_PROVIDER_URL=
# Optional comma-separated WebSocket failover list; overrides the single URL.
WEB3_WS_PROVIDER_URLS=
WEB3_PENDING_SUBSCRIPTION=alchemy_pendingTransactions
PENDING_TTL_SECONDS=300
PENDING_RETENTION_SECONDS=86400
PENDING_MAX_RECORDS=10000
# Backward-compatible admin key, or use the separate roles below.
API_KEY=
VIEWER_API_KEY=
REVIEWER_API_KEY=
ADMIN_API_KEY=
SSL_CERTFILE=
SSL_KEYFILE=
BACKUP_DIR=backups
ALERT_WEBHOOK_URL=
# Optional high-risk email delivery (STARTTLS); credentials stay on the server.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
LIVE_POLL_SECONDS=6
LIVE_CONFIRMATIONS=2
LIVE_BACKFILL_BLOCKS=5
LIVE_MAX_CATCHUP_BLOCKS=100
LIVE_CATCHUP_CONCURRENCY=4
LIVE_MIN_WALLET_EVENTS=10
LIVE_DISPLAY_LIMIT=25
LIVE_RETENTION_BLOCKS=256
LIVE_PRUNE_EVERY_BLOCKS=100
LIVE_DRIFT_Z_THRESHOLD=3
LIVE_INCLUDE_RECEIPTS=false
